# Bu dosyayi ".env" olarak kopyalayin ve kendi degerlerinizi yazin.
# .env dosyasi .gitignore ile hariç tutulur, repoya gitmez.
#
# Yeni bir anahtar uretmek icin:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=buraya-uretilen-rastgele-anahtari-yazin
ALGORITHM=HS256
TOKEN_SURESI_DAKIKA=480
